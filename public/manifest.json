{
  "manifest_version": 3,
  "name": "Layr — Visual HTML & CSS Inspector",
  "short_name": "Layr",
  "description": "Look beyond the pixels. Inspect HTML, CSS, and layout in a lightweight side panel. Entirely local.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "toggle-freeze-hover": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Freeze or unfreeze Layr hover inspection"
    }
  },
  "action": {
    "default_title": "Inspect with Layr",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
